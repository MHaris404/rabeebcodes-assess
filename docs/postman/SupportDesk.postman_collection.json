          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (!pm.collectionVariables.get(\"ticketCreateKey\")) pm.collectionVariables.set(\"ticketCreateKey\", pm.variables.replaceIn(\"{{$guid}}\"));"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"ticketId\", json.data.id);",
                  "pm.collectionVariables.set(\"ticketVersion\", json.data.version);",
                  "pm.test(\"Ticket has a generated ID\", () => pm.expect(json.data.ticketNumber).to.match(/^SD-\\d+$/));"
                ]
              }
            }
          ]
