            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
                  "[\"ticketId\", \"ticketVersion\", \"ticketCreateKey\", \"replyKey\", \"messageId\", \"messageCursor\", \"activityCursor\"].forEach(key => pm.collectionVariables.unset(key));"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              }
            ],
            "url": "{{baseUrl}}/auth/logout",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 204\", () => pm.response.to.have.status(204));",
                  "pm.collectionVariables.unset(\"csrfToken\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify logged out",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/me",
            "description": ""
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));",
                  "const json = pm.response.json();",
                  "pm.test(\"Session denied\", () => pm.expect(json.error.code).to.equal(\"UNAUTHENTICATED\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Registration reference (manual)",
      "item": [
        {
          "name": "Register a new Customer",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/register",
            "description": "Manual reference: creates a new Customer and changes the cookie session to that Customer. Run Login again to return to Admin. Public registrations are rate-limited to five attempts per 15 minutes per process.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Postman Customer\",\n  \"email\": \"postman-{{$timestamp}}@example.com\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "pm.test(\"Safe user DTO\", () => { pm.expect(json.data.user).not.to.have.property(\"passwordHash\"); });",
                  "pm.collectionVariables.set(\"csrfToken\", json.data.csrfToken);",
                  "pm.collectionVariables.set(\"currentUserId\", json.data.user.id);",
                  "pm.test(\"Public registration creates Customer\", () => pm.expect(json.data.user.role).to.equal(\"Customer\"));"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
