        {
          "name": "Login as selected demo user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Origin",
                "value": "{{origin}}"
              },
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-CSRF-Token",
                "value": "{{csrfToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/auth/login",
            "description": "Default core workflow requires Admin. Postman stores the HttpOnly session cookie automatically; leave its cookie jar enabled.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const json = pm.response.json();",
                  "pm.test(\"Safe user DTO\", () => { pm.expect(json.data.user).not.to.have.property(\"passwordHash\"); });",
                  "pm.collectionVariables.set(\"csrfToken\", json.data.csrfToken);",
                  "pm.collectionVariables.set(\"currentUserId\", json.data.user.id);"
                ]
              }
            }
          ]
        },
